name: Build & deploy

on:
  push:
    branches: [prod]
  workflow_dispatch: # lets you trigger it manually from the Actions tab too

permissions:
  contents: write # needed to push to the deployed branch

concurrency:
  group: deploy
  cancel-in-progress: true

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout prod
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build (static)
        run: npx nuxt generate
        # env:
        #   NUXT_PUBLIC_API_BASE: ${{ secrets.API_BASE }}

      - name: Push build output to deployed branch
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_branch: deployed
          publish_dir: ./.output/public
          user_name: github-actions[bot]
          user_email: github-actions[bot]@users.noreply.github.com
          commit_message: "Deploy ${{ github.sha }}"
